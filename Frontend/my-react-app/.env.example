# Firebase project config. Copy this file to .env.development (demo) or
# .env.production (prod) and fill in your project's values. Those files are
# git-ignored; keys never live in a committed .js file. Find these under
# Firebase console -> Project settings -> General -> Your apps -> SDK setup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# "demo" or "prod" — anything but "prod" shows an environment banner.
VITE_ENV_LABEL=demo

# Bypasses verification and domain checks for local demos. Never true in prod.
VITE_TEST_MODE=false

# Reserved for the backend API integration.
VITE_API_BASE=http://localhost:3000/api