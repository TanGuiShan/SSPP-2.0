@import "tailwindcss";
/* Explicit content config — guarantees Tailwind scans the source for classes. */
@config "../../tailwind.config.js";
@import "@govtechsg/sgds-web-component/themes/day.css";
@import "@govtechsg/sgds-web-component/themes/night.css";
@import "@govtechsg/sgds-web-component/css/sgds.css";
@import "./variables.css";

@layer base {
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    min-height: 100%;
    scroll-behavior: smooth;
  }

  body,
  #root {
    min-height: 100dvh;
  }

  body {
    margin: 0;
    color: var(--color-text);
    background: var(--color-bg);
    font-family: var(--font-body);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin-top: 0;
  }

  h1,
  h2,
  h3,
  h4 {
    color: var(--sgds-heading-color-default, var(--color-text));
    font-family: var(--font-display);
  }

  h1 {
    font-size: clamp(1.875rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  h2 {
    font-size: 1.25rem;
    line-height: 1.3;
  }

  a {
    color: var(--sgds-link-color-default, inherit);
  }

  button,
  input,
  textarea,
  select {
    font: inherit;
  }

  button {
    cursor: pointer;
  }

  :focus-visible {
    outline: 2px solid var(--sgds-primary-color-default, #2459a9);
    outline-offset: 2px;
  }
}

@layer components {
  .eyebrow {
    margin-bottom: 0.375rem;
    color: var(--sgds-primary-color-default, var(--color-info));
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-card);
  }

  /* Full application frame */
  .sspp-app-shell,
  .sspp-public-shell {
    min-height: 100dvh;
    background: var(--color-bg);
  }

  .sspp-app-shell {
    display: flex;
    flex-direction: column;
  }

  .sspp-app-frame {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .sspp-sidebar {
    position: sticky;
    top: 0;
    z-index: 30;
    align-self: flex-start;
    height: 100dvh;
    flex: 0 0 auto;
  }

  .sspp-sidebar-brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    padding: 0.5rem 0.25rem;
  }

  .sspp-sidebar-logo,
  .sspp-sidebar-mark {
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border-radius: 0.625rem;
  }

  .sspp-sidebar-logo {
    object-fit: cover;
  }

  .sspp-sidebar-mark {
    display: grid;
    place-items: center;
    color: var(--sgds-primary-color-fixed-light, #fff);
    background: var(--sgds-primary-surface-emphasis, #2459a9);
    font-weight: 800;
  }

  .sspp-sidebar-brand-copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
  }

  .sspp-sidebar-brand-copy strong {
    color: var(--color-text);
    font-size: 1rem;
  }

  .sspp-sidebar-brand-copy span {
    overflow: hidden;
    color: var(--color-text-muted);
    font-size: 0.6875rem;
    letter-spacing: 0.04em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .sspp-sidebar-icon {
    display: inline-grid;
    place-items: center;
  }

  .sspp-sidebar-lower {
    padding: 0.5rem 0;
  }

  .sspp-app-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    overflow: auto;
  }

  .sspp-main-content {
    flex: 1;
    padding: clamp(1.25rem, 4vw, 2.5rem);
  }

  .sspp-content-container {
    width: min(100%, 76rem);
    margin-inline: auto;
  }

  .sspp-test-banner {
    position: relative;
    z-index: 40;
    padding: 0.5rem clamp(1rem, 3vw, 2rem);
    background: var(--sgds-warning-bg-muted, #fff4dc);
  }

  /* Page headings */
  .sspp-page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .sspp-page-subtitle {
    max-width: 48rem;
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    line-height: 1.55;
  }

  .sspp-page-action {
    flex: 0 0 auto;
  }

  /* SGDS form wrappers */
  .sgds-field,
  .sgds-choice-field {
    min-width: 0;
    margin-bottom: 1.25rem;
  }

  .sgds-field > sgds-input,
  .sgds-field > sgds-textarea,
  .sgds-field > sgds-select,
  .sgds-field > sgds-datepicker {
    display: block;
    width: 100%;
  }

  .sgds-field-label {
    display: block;
    margin-bottom: 0.5rem;
    color: var(--sgds-form-color-default, var(--color-text));
    font-size: 0.875rem;
    font-weight: 600;
  }

  .sgds-field-label span {
    color: var(--color-danger);
  }

  .sgds-field-hint {
    margin: -0.125rem 0 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .sgds-choice-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 0.75rem 1rem;
  }

  .sgds-radio-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .sgds-radio-card {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  .sgds-radio-card p {
    margin: 0.375rem 0 0 1.75rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
    line-height: 1.45;
  }

  .sgds-dialog-body {
    min-width: 0;
    padding-top: 0.5rem;
  }

  /* Cards and metrics */
  .sspp-form-section {
    display: block;
    margin-bottom: 1.25rem;
  }

  .sspp-section-heading {
    display: flex;
    align-items: flex-start;
    gap: 0.875rem;
    margin-bottom: 1.5rem;
  }

  .sspp-section-heading h2 {
    margin: 0;
  }

  .sspp-section-heading p {
    margin: 0.375rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .sspp-step-number {
    display: grid;
    width: 1.75rem;
    height: 1.75rem;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 999px;
    color: var(--sgds-primary-color-fixed-light, #fff);
    background: var(--sgds-primary-surface-emphasis, #2459a9);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .sspp-stat-card {
    display: block;
    min-width: 10rem;
    flex: 1;
  }

  .sspp-stat-card--clickable {
    cursor: pointer;
  }

  .sspp-stat-card--clickable:hover {
    transform: translateY(-1px);
  }

  .sspp-stat-card-content {
    padding: 1.25rem 1.5rem;
  }

  .sspp-stat-card-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .sspp-stat-card-heading p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .sspp-stat-card-content > strong {
    display: block;
    margin-top: 0.5rem;
    color: var(--color-text);
    font-size: 2rem;
    line-height: 1.1;
  }

  .sspp-stat-card-hint {
    display: block;
    margin-top: 0.375rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  /* Filters */
  .sspp-filter-panel {
    margin-bottom: 1.5rem;
    padding: 1.25rem;
  }

  .sspp-filter-heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .sspp-filter-heading h2,
  .sspp-filter-heading p {
    margin: 0;
  }

  .sspp-filter-heading p {
    margin-top: 0.25rem;
    color: var(--color-text-muted);
    font-size: 0.8125rem;
  }

  .sspp-filter-dates {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 18rem));
    gap: 1rem;
  }

  .sspp-filter-groups {
    display: grid;
    gap: 1.25rem;
  }

  .sspp-filter-groups fieldset {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .sspp-filter-groups legend {
    margin-bottom: 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  /* Auth and public pages */
  .sspp-public-shell {
    display: flex;
    flex-direction: column;
  }

  .sspp-auth-layout {
    display: grid;
    min-height: min(48rem, calc(100dvh - 6rem));
    flex: 1;
    grid-template-columns: minmax(20rem, 0.9fr) minmax(24rem, 1.1fr);
    background: var(--color-surface);
  }

  .sspp-auth-visual {
    position: relative;
    min-height: 38rem;
    overflow: hidden;
    background: var(--sgds-bg-fixed-dark, #111);
  }

  .sspp-auth-visual > img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sspp-auth-visual::after {
    position: absolute;
    inset: 0;
    content: "";
    background: linear-gradient(180deg, transparent 25%, rgb(0 0 0 / 0.78));
  }

  .sspp-auth-visual-overlay {
    position: absolute;
    z-index: 1;
    right: 0;
    bottom: 0;
    left: 0;
    padding: clamp(2rem, 5vw, 4rem);
    color: #fff;
  }

  .sspp-auth-kicker {
    margin-bottom: 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  .sspp-auth-visual-overlay h1 {
    max-width: 36rem;
    margin: 0;
    color: #fff;
  }

  .sspp-auth-panel {
    display: grid;
    place-items: center;
    padding: clamp(2rem, 6vw, 5rem);
  }

  .sspp-auth-panel-inner {
    width: min(100%, 28rem);
  }

  .sspp-signup-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface);
  }

  .sspp-signup-header-inner {
    display: flex;
    width: min(100% - 2rem, 52rem);
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-inline: auto;
    padding-block: 1.25rem;
  }

  .sspp-signup-header-inner > div {
    display: flex;
    flex-direction: column;
  }

  .sspp-signup-header-inner span {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  .sspp-signup-header-inner a {
    font-size: 0.875rem;
  }

  .sspp-signup-main {
    width: min(100% - 2rem, 52rem);
    flex: 1;
    margin-inline: auto;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .sspp-signup-intro {
    margin-bottom: 2rem;
  }

  .sspp-signup-intro > p:last-child {
    max-width: 44rem;
    margin: 0.625rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  /* Tables: sgds-table receives existing semantic table markup through slot. */
  sgds-table,
  sgds-footer,
  sgds-masthead {
    display: block;
  }

  sgds-table table {
    width: 100%;
  }

  .sspp-table-shell {
    overflow-x: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }

  /* Existing native controls that remain specialised (chips, upload helpers). */
  .sspp-native-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 1rem;
    color: var(--sgds-form-color-default, var(--color-text));
    border: 1px solid var(--sgds-border-color-default, var(--color-border));
    border-radius: var(--radius-sm);
    background: var(--sgds-form-surface-default, #fff);
  }

  .sspp-native-input:hover {
    border-color: var(--sgds-border-color-emphasis, var(--color-border-emphasis));
  }

  .sspp-native-input:focus {
    outline: 2px solid var(--sgds-primary-color-default, #2459a9);
    outline-offset: 1px;
  }
}

@media (max-width: 900px) {
  .sspp-auth-layout {
    display: block;
  }

  .sspp-auth-visual {
    display: none;
  }

  .sspp-auth-panel {
    min-height: 38rem;
    padding: 2rem 1.25rem;
  }
}

@media (max-width: 768px) {
  .sspp-app-frame {
    display: block;
  }

  .sspp-sidebar {
    position: relative;
    width: 100%;
    height: auto;
  }

  .sspp-main-content {
    padding: 1.25rem 1rem 2rem;
  }

  .sspp-page-header,
  .sspp-signup-header-inner {
    align-items: stretch;
    flex-direction: column;
  }

  .sspp-page-action > * {
    width: 100%;
  }

  .sspp-filter-dates {
    grid-template-columns: 1fr;
  }
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.001ms !important;
    transition-duration: 0.001ms !important;
  }
}

/* Verification flow */
.verified-field {
  margin-bottom: 1.25rem;
}

.verified-field__main-row,
.verified-field__code-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: end;
  gap: 0.75rem;
}

.verified-field__input,
.verified-field__code-input {
  margin-bottom: 0;
}

.verified-field__code-row {
  margin-top: 0.75rem;
}

.verified-field__code-input {
  max-width: 18rem;
}

.verified-field__action {
  padding-bottom: 0.125rem;
}

.verified-field__hint {
  margin: 0.5rem 0 0;
  color: var(--color-text-muted);
  font-size: 0.8125rem;
}

.verified-field__alert {
  display: block;
  margin-top: 0.75rem;
}

/* Route-level lazy-loading feedback */
.route-loading {
  min-height: 12rem;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.75rem;
  color: var(--color-text-muted);
  font-size: 0.9375rem;
}

@media (max-width: 640px) {
  .verified-field__main-row,
  .verified-field__code-row {
    grid-template-columns: 1fr;
    align-items: stretch;
  }

  .verified-field__action > * {
    width: 100%;
  }
}
