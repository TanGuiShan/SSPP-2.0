@startuml seq06_submit_open_request
skinparam backgroundColor white
skinparam sequenceArrowThickness 1.2
skinparam roundcorner 8
skinparam maxMessageSize 220
skinparam sequence {
  ActorBorderColor #2b6fb3
  ActorBackgroundColor #e7edf5
  ParticipantBorderColor #2b6fb3
  ParticipantBackgroundColor #bfe0f5
  LifeLineBorderColor #888888
  ArrowColor #222222
  NoteBackgroundColor #fff6cf
  NoteBorderColor #b8a23a
}
title Submit Open Request\n<size:12><i>from components/formation/OpenRequestModal.jsx, useEngagements.jsx — submitOpenRequest()</i></size>

actor "School" as school
boundary "OpenRequestModal" as modal
control "useEngagements()" as hook
database "matches/{id}" as db

autonumber 1

school -> modal ++ : fillOpenRequestForm(category,\nvolunteersNeeded, tier, date)
modal -> hook ++ : submitOpenRequest(payload)
hook -> db ++ : create match\n(isOpen: true, roster: [], status: "Open")

note over db
  no target chosen yet — target stays null
  until the school later confirms volunteers
end note

db --> hook -- : created
hook --> modal -- : match (Open)
modal --> school -- : show request posted

@enduml
